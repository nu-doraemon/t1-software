# Pins for the shared base image -- Torch x JAX + ROOT x GEANT4 only. No subgroup package
# (JAXTPC, pimm-data, ...) belongs here; those pin independently in
# subgroups/<name>/versions.env.
# cuda12 variant only for now; cuda13 deferred until a driver >=580.65.06
# host exists to build and verify it.
CUDA_VARIANT=cuda12
TORCH_VERSION=2.13.0+cu129
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu129
# Bounded to satisfy JAXTPC's own requirements.txt (jax>=0.4,<0.7) so its
# later `pip install -r requirements.txt` never touches this pin.
JAX_VERSION=0.6.2

# Shared ROOT x GEANT4 layer -- conda-forge prebuilt binaries into the
# image's single /opt/conda prefix, which also hosts the pip-installed
# Torch/JAX above (one python3 for PyROOT and Torch/JAX alike; see
# base/Containerfile). Any future T1 subgroup needing GEANT4-based simulation
# shares this same pin -- bump it here, not per-subgroup.
# conda-forge CPython (a final release; Ubuntu 22.04's apt python3.11 is
# 3.11.0rc1). root_base ROOT_VERSION ships a py311 build.
PYTHON_VERSION=3.11
# root_base (not the `root` conda-forge metapackage) -- root_base is the
# real ROOT + PyROOT install; `root` additionally drags in a full
# ipython/jupyter/notebook/numba stack this image never uses.
ROOT_VERSION=6.32.16
# noqt build variant: skips Qt6 visualization + its own G4Py/boost-python
# bindings, neither used by edep-sim (C++-only) or this image. Pulls in
# every geant4-data-* dataset package as a hard dependency (G4NDL,
# G4EMLOW, G4PhotonEvaporation, ... ~1.5 GB) -- required for edep-sim's
# default physics lists (e.g. FTFP_BERT) to initialize at all, so unlike
# goop's host-side photon-library asset, this data is baked into the
# image rather than left for the operator to mount.
# Pinned to the 10.x series, not the newest conda-forge build (11.4.2):
# drinkingkazu/edep-sim (subgroups/lartpc/versions.env EDEPSIM_COMMIT)
# vendors its own physics-list snapshot (EDepSimPhysicsList.cc,
# G4HadronPhysicsQGSP_BERT_Bias.*) written against Geant4's 10.x
# hadronic-physics and vis-attributes API (G4VisAttributes::Invisible,
# global G4BestUnit(), G4HadronFissionProcess.hh) that Geant4 11.x
# removed/refactored -- confirmed by a failed noqt 11.4.2 build attempt.
# edep-sim's own README claims it "will probably build with any recent
# version of GEANT4"; that is only true within the 10.x series it was
# tested against (README cites 10.2), not across the 11.x break.
GEANT4_VERSION=10.7.4
GEANT4_BUILD_VARIANT=noqt_*
# GCC series root_base ROOT_VERSION was compiled with (its cling checks
# the runtime libstdc++ headers' __GLIBCXX__ against it). Bump together
# with ROOT_VERSION.
GXX_VERSION=14.3
# Static installer for the conda-forge env above (kept in the image).
# sha256 pinned against the published release asset.
MICROMAMBA_VERSION=2.9.0-0
MICROMAMBA_SHA256=366cd9cd8be14df1ab8ed50352a82111082a36686b2d389fdb79a92c3fafb3e3
