Bootstrap: docker
From: nvidia/cuda:12.9.1-cudnn-devel-ubuntu22.04

# t1-base -- shared Torch x JAX + ROOT x GEANT4 layer (one conda python) for all T1-LArTPC subgroups. No
# subgroup-specific package (JAXTPC, pimm-data, LUCiD, ...) belongs in
# this image -- add those in subgroups/<name>/*.def instead, layered on
# top via `Bootstrap: localimage`.
#
# Templated with: apptainer build --build-arg-file base/versions.env \
#   images/t1-base-{{ CUDA_VARIANT }}.sif base/base.def

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends curl ca-certificates
    rm -rf /var/lib/apt/lists/*

    # ONE Python for the whole image: conda-forge's CPython 3.11 at
    # /opt/conda, shared by PyROOT (root_base's own py311 build) and the
    # pip-installed Torch x JAX stack below. Two interpreters (Ubuntu's
    # apt python3.11 for Torch/JAX + a separate conda python for PyROOT)
    # meant bare `python3` could only ever serve one of them -- e.g.
    # DLPGenerator's `#!/usr/bin/env python3` dlpgen needs `import ROOT`
    # while every Torch/JAX consumer needs the other interpreter -- so the
    # two stacks now live in one prefix. ROOT/GEANT4 come from conda-forge
    # (prebuilt; building either from source in a fakeroot %post would
    # take hours), Torch/JAX from their own CUDA-tagged pip wheels.
    # micromamba is kept in the image (single static binary) so subgroup
    # overlays can add their own conda-forge packages into this prefix.
    curl -fsSL -o /usr/local/bin/micromamba \
        "https://github.com/mamba-org/micromamba-releases/releases/download/{{ MICROMAMBA_VERSION }}/micromamba-linux-64"
    echo "{{ MICROMAMBA_SHA256 }}  /usr/local/bin/micromamba" | sha256sum -c -
    chmod +x /usr/local/bin/micromamba

    # gxx_linux-64 pinned to the GCC series root_base was built with:
    # cling compares the libstdc++ headers it parses at runtime against
    # the __GLIBCXX__ it was compiled with, and an unpinned solve pulls a
    # newer gcc point release, giving a (harmless but alarming)
    # "Possible C++ standard library mismatch" warning on every rootcling
    # / PyROOT start. `numpy>=2`: JAXTPC uses numpy-2-only API
    # (np.trapezoid); conda owns numpy so pip never swaps it under
    # root_base's compiled bindings. `expat`/`hdf5`/`h5py`: geant4
    # only pulls the libexpat runtime, not the headers/CMake config
    # edep-sim's find_package(EXPAT) needs; hdf5 is edep-sim's H5DLP
    # C++ output layer, and h5py must link that same libhdf5 so Python
    # readers and the C++ writer share one HDF5 build.
    export MAMBA_ROOT_PREFIX=/opt/micromamba
    micromamba create -y -p /opt/conda -c conda-forge --override-channels \
        "python={{ PYTHON_VERSION }}" \
        "root_base={{ ROOT_VERSION }}" \
        "geant4={{ GEANT4_VERSION }}={{ GEANT4_BUILD_VARIANT }}" \
        "gxx_linux-64={{ GXX_VERSION }}" \
        "numpy>=2" scipy expat hdf5 h5py pyyaml pip
    micromamba clean -y -a

    # One libstdc++ per process: torch's wheel resolves libstdc++.so.6
    # through the system search path (Ubuntu's GCC 11 copy), and once
    # that is loaded ROOT's libCling/libcppyy_backend (GCC 14, need
    # GLIBCXX_3.4.31) fail with "could not load cppyy_backend library"
    # whenever torch is imported before ROOT. Register conda's newer
    # libstdc++/libgcc_s ahead of the system dir image-wide -- libstdc++
    # is backward compatible, so every Ubuntu binary keeps working -- via
    # a directory holding only those two libraries (NOT all of
    # /opt/conda/lib, whose OpenSSL/zlib/etc. must never shadow Ubuntu's).
    mkdir -p /opt/conda/lib-runtime
    ln -sf /opt/conda/lib/libstdc++.so.6 /opt/conda/lib-runtime/libstdc++.so.6
    ln -sf /opt/conda/lib/libgcc_s.so.1 /opt/conda/lib-runtime/libgcc_s.so.1
    echo /opt/conda/lib-runtime > /etc/ld.so.conf.d/000-conda-libstdcxx.conf
    ldconfig
    ldconfig -p | grep -m1 'libstdc++.so.6 ' | grep -q /opt/conda/lib-runtime

    PY=/opt/conda/bin/python3
    # Torch pinned FIRST via its own CUDA-tagged index -- installing JAX
    # (or anything else) before this must never be allowed to pull a
    # different Torch build; later installs resolve against it.
    $PY -m pip install --no-cache-dir \
        "torch=={{ TORCH_VERSION }}" --index-url {{ TORCH_INDEX_URL }}
    # JAX CUDA 12 wheel bundle (nvidia-* runtime libs from PyPI).
    $PY -m pip install --no-cache-dir "jax[cuda12]=={{ JAX_VERSION }}"

    # Runtime activation, sourced by %environment (so every
    # `apptainer exec/run/shell` gets it -- no manual setup step): PATH,
    # ROOTSYS, the G4*DATA dataset vars, etc. from conda's own
    # activate.d hooks. The compiler hooks (gcc/gxx/binutils) are
    # deliberately skipped here: they export CC/CXX/CFLAGS/LDFLAGS for
    # conda's cross toolchain, which would silently hijack every unrelated
    # build (`pip install` of an sdist, a user's own make). Those are
    # opt-in via /opt/setup-g4root.sh below. POSIX sh (apptainer sources
    # %environment with /bin/sh).
    cat > /opt/conda/etc/t1-runtime.sh <<'RUNTIME_EOF'
export CONDA_PREFIX=/opt/conda
# cling (PyROOT, rootcling) locates glibc headers through this; without
# it `import ROOT` fails with "'assert.h' file not found". Normally set by
# the gcc hook skipped below; it is a path, not a compiler flag.
export CONDA_BUILD_SYSROOT="$CONDA_PREFIX/x86_64-conda-linux-gnu/sysroot"
for f in "$CONDA_PREFIX"/etc/conda/activate.d/*.sh; do
    case "$f" in *gcc_linux*|*gxx_linux*|*binutils_linux*) continue ;; esac
    # geant4-data hooks warn when their var is already set (nested exec).
    [ -e "$f" ] && . "$f" >/dev/null 2>&1
done
unset f
case ":$PATH:" in *":$CONDA_PREFIX/bin:"*) ;; *) PATH="$CONDA_PREFIX/bin:$PATH" ;; esac
export PATH
RUNTIME_EOF

    cat > /opt/setup-g4root.sh <<'SETUP_EOF'
#!/usr/bin/env bash
# Build-toolchain activation for compiling against ROOT/GEANT4 in this
# image (e.g. DLPGenerator, edep-sim). The runtime environment (python3,
# PyROOT, root, geant4 data) is already active in every apptainer
# session; this adds only conda's compiler settings (CC/CXX/CFLAGS/
# LDFLAGS/CMAKE_ARGS for the GCC ROOT itself was built with), kept out of
# the default environment so unrelated builds never pick them up.
#
#   source /opt/setup-g4root.sh
#
export G4ROOT_CONDA_PREFIX=/opt/conda
. /opt/conda/etc/t1-runtime.sh
# Third-party hooks are not nounset-safe; relax -u just for them.
case "$-" in *u*) _g4root_had_nounset=1 ;; *) _g4root_had_nounset=0 ;; esac
set +u
for f in "$CONDA_PREFIX"/etc/conda/activate.d/*.sh; do
    case "$f" in *gcc_linux*|*gxx_linux*|*binutils_linux*) . "$f" ;; esac
done
unset f
[ "$_g4root_had_nounset" = 1 ] && set -u
unset _g4root_had_nounset
export CMAKE_PREFIX_PATH="$CONDA_PREFIX:${CMAKE_PREFIX_PATH:-}"
SETUP_EOF
    chmod +x /opt/setup-g4root.sh

%environment
    . /opt/conda/etc/t1-runtime.sh
    export PYTHONPATH=/opt
    export PYTHONDONTWRITEBYTECODE=1

%test
    # apptainer runs %test without -e; a failed check must fail the build.
    set -e
    # Bare python3 must be the one interpreter carrying every stack.
    [ "$(command -v python3)" = /opt/conda/bin/python3 ]
    [ "$(command -v python)" = /opt/conda/bin/python ]
    # torch imported BEFORE ROOT on purpose: the libstdc++ ordering case.
    python3 -c "import torch, jax, ROOT; \
print('torch', torch.__version__, 'cuda', torch.version.cuda); \
print('jax', jax.__version__, 'devices', jax.devices()); \
print('PyROOT', ROOT.gROOT.GetVersion()); \
ROOT.gInterpreter.Declare('#include <cassert>\\nint t1_probe(){assert(1); return 7;}'); \
assert ROOT.t1_probe() == 7"
    root-config --version
    geant4-config --version
    [ -n "$G4NEUTRONHPDATA" ] && [ -d "$G4NEUTRONHPDATA" ]
    # Compiler settings must stay out of the default environment.
    [ -z "${CXXFLAGS:-}" ]
    # No libstdc++ ABI-mismatch warning from cling (GXX_VERSION pin).
    out="$(bash -c 'source /opt/setup-g4root.sh && root -b -q -l -e "int t1_probe = 0;" 2>&1')"
    echo "$out"
    ! echo "$out" | grep -q "standard library mismatch"
