# Pins for the water-Cherenkov (WC) subgroup overlay.
# Pins are bumped by hand. `scripts/build.sh --pin KEY=VALUE` overrides
# one for a single build without editing this file. Each <PKG>_REPO is
# the clone URL the Containerfile uses for that package.

# LUCiD: differentiable optical-photon simulation, calibration and
# reconstruction for water-Cherenkov / WbLS / ice detectors (JAX).
LUCID_REPO=https://github.com/CIDeR-ML/LUCiD.git
# Release v0.6.0 (ghcr.io/cider-ml/lucid:v0.6.0), the first release that
# accepts the base's JAX 0.6.2.
LUCID_COMMIT=e651e836b420f541b02672d9866e6219f2c6d66d

# PhotonSim: the Geant4 optical-photon application LUCiD's production
# chain (lucid-run-job) runs as a subprocess. Pinned at the commit of
# tag v1.0.3, the ref LUCiD's own container workflow builds against.
PHOTONSIM_REPO=https://github.com/cesarjesusvalls/PhotonSim.git
PHOTONSIM_COMMIT=99d5743976fa9d2795a0375b67024b565a519494

# PhotonSim's own toolchain prefix (/opt/photonsim-g4). PhotonSim calls
# G4RunManagerFactory, which exists only from Geant4 11.0; the shared
# base stays on Geant4 10.7 because the LArTPC overlay's edep-sim fork
# does not build on 11.x. So PhotonSim gets a separate conda prefix with
# its own Geant4, ROOT (PhotonSim writes ROOT files) and compiler, and
# nothing else in the image sees it. ROOT matches the base's ROOT
# version; GXX matches the GCC series that ROOT build was made with.
PHOTONSIM_GEANT4_VERSION=11.3.2
PHOTONSIM_GEANT4_BUILD_VARIANT=noqt_*
PHOTONSIM_ROOT_VERSION=6.32.16
PHOTONSIM_GXX_VERSION=14.3
