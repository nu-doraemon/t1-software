Bootstrap: localimage
From: {{ BASE_SIF }}

# t1-lartpc -- LArTPC subgroup overlay on top of t1-base. Adds JAXTPC
# (detector simulation), pimm-data (HDF5 dataset loader), goop
# (differentiable PMT/light-readout simulation), and DLPGenerator +
# edep-sim (event generation -> Geant4 energy-deposition simulation),
# each pinned independently of each other and of the shared base. All
# Python packages install into the base image's single /opt/conda
# python3 (Torch/JAX/PyROOT share it).
#
# goop has no setup.py/pyproject -- upstream runs it from source via
# PYTHONPATH, not `pip install`, so only its runtime deps are installed
# below and the checkout itself is left on disk. goop vendors its own
# JAXTPC copy as a git submodule (goop/jaxtpc); that submodule is
# deliberately left uninitialized here (plain `git clone`, no
# --recursive) so goop's `tools.*` imports resolve against this image's
# single pinned /opt/JAXTPC checkout instead of a second, potentially
# skewed JAXTPC commit. goop's own multi-GB photon-library asset
# (default /sdf/data/neutrino/youngsam/compressed_plib_b04_quantile_log_n50.h5)
# is a host-side file read at runtime, never baked into the image.
#
# Templated with:
#   apptainer build --build-arg-file subgroups/lartpc/versions.env \
#     --build-arg BASE_SIF=images/t1-base-cuda12.sif \
#     images/t1-lartpc-cuda12.sif subgroups/lartpc/lartpc.def

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends git
    rm -rf /var/lib/apt/lists/*

    export MAMBA_ROOT_PREFIX=/opt/micromamba
    PY=/opt/conda/bin/python3
    # Compiled/native deps from conda-forge into the shared prefix, so
    # they link the same libstdc++/HDF5 as ROOT/GEANT4 (h5py, numpy
    # already come from base). yaml-cpp/cmake/make: edep-sim's build
    # toolchain, matching conda's compiler (no apt build-essential mixing
    # Ubuntu headers into conda's sysroot). --freeze-installed keeps the
    # base pins (numpy, python, root_base) untouched. cmake<4: edep-sim's
    # cmake_minimum_required predates 3.5, which CMake 4 refuses.
    micromamba install -y -p /opt/conda -c conda-forge --override-channels \
        --freeze-installed matplotlib tqdm pytest pytest-benchmark \
        pywavelets yaml-cpp "cmake<4" make
    micromamba clean -y -a

    # pytest-benchmark (above) is required just to parse goop's own
    # pytest.ini (`addopts = --benchmark-skip`).

    mkdir -p /opt
    cd /opt
    git clone --quiet https://github.com/DeepLearnPhysics/JAXTPC.git
    cd JAXTPC
    git checkout --quiet {{ JAXTPC_COMMIT }}
    # JAXTPC's own requirements.txt is bounded (jax>=0.4,<0.7) so it never
    # clobbers the base image's JAX pin; Torch is not in this file at all.
    $PY -m pip install --no-cache-dir -r requirements.txt

    cd /opt
    git clone --quiet https://github.com/omaralterkait/pimm-data.git
    cd pimm-data
    git checkout --quiet {{ PIMM_DATA_COMMIT }}
    # pimm-data excludes torch from its dependency list, so this install
    # never reinstalls a different Torch build. Editable (`-e`): a regular
    # `pip install .` omits src/pimm_data/data/*.json (no package-data
    # declared upstream), breaking its plane-geometry lookups. `.[test]`
    # pulls its pytest extra so its suite is runnable in-image below.
    $PY -m pip install --no-cache-dir -e .[test]

    cd /opt
    # Non-recursive clone -- see header comment: goop/jaxtpc stays an
    # empty, uninitialized submodule directory on purpose. goop is plain
    # source on PYTHONPATH (no setup.py/pyproject upstream).
    git clone --quiet https://github.com/CIDeR-ML/goop.git
    cd goop
    git checkout --quiet {{ GOOP_COMMIT }}

    # Event generation: DLPGenerator (ParticleBomb) built first, then
    # edep-sim (drinkingkazu's fork -- adds src/kinem/ParticleBombGenerator,
    # which links DLPGenerator's ParticleBomb directly into edep-sim's own
    # "/generator/kinematics/set bomb" seam, so the build order below is
    # load-bearing). Built with conda's own compiler via
    # /opt/setup-g4root.sh -- the same GCC series ROOT/GEANT4 were built
    # with. bash, not %post's /bin/sh: DLPGenerator's setup.sh is
    # bash-only (`${BASH_SOURCE[0]}`, `[[ ]]`). No `-u`: neither
    # setup.sh nor conda's hooks are nounset-safe.
    bash <<'GEN_BUILD_EOF'
set -e
source /opt/setup-g4root.sh

cd /opt
git clone --quiet https://github.com/DeepLearnPhysics/DLPGenerator.git
cd DLPGenerator
git checkout --quiet {{ DLPGENERATOR_COMMIT }}
# Upstream's setup.sh exports DLPGENERATOR_{DIR,LIBDIR,INCDIR,...};
# edep-sim's cmake below reads DLPGENERATOR_INCDIR/LIBDIR from the
# environment, so it stays sourced through edep-sim's build.
source setup.sh
make
# Upstream pytest suite through PyROOT: proves the ParticleBomb
# dictionary loads and its multiplicity/weight logic holds.
make test
chmod +x bin/dlpgen

cd /opt
git clone --quiet https://github.com/drinkingkazu/edep-sim.git
cd edep-sim
git checkout --quiet {{ EDEPSIM_COMMIT }}
mkdir -p build && cd build
# EDEPSIM_DISPLAY=OFF: skips the interactive ROOT/G4 event-display GUI.
# RPATH bakes edep-sim's own lib dir, /opt/conda/lib, and DLPGenerator's
# build/lib into the installed binary. yaml-cpp comes from conda
# (above), whose include dir is already on conda's -isystem CXXFLAGS.
cmake $CMAKE_ARGS \
    -DCMAKE_INSTALL_PREFIX=/opt/edep-sim-install \
    -DCMAKE_PREFIX_PATH="$CMAKE_PREFIX_PATH" \
    -DEDEPSIM_DISPLAY=OFF \
    -DCMAKE_INSTALL_RPATH="/opt/edep-sim-install/lib;$CONDA_PREFIX/lib;$DLPGENERATOR_LIBDIR" \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=TRUE \
    -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=TRUE \
    ..
make -j"$(nproc)"
make install
GEN_BUILD_EOF

%environment
    # DLPGenerator runtime env (mirrors its own setup.sh) + edep-sim, so
    # dlpgen / PyROOT's ParticleBomb / edep-sim work in every session
    # with no manual setup step.
    export DLPGENERATOR_DIR=/opt/DLPGenerator
    export DLPGENERATOR_BINDIR=$DLPGENERATOR_DIR/bin
    export DLPGENERATOR_BUILDDIR=$DLPGENERATOR_DIR/build
    export DLPGENERATOR_LIBDIR=$DLPGENERATOR_BUILDDIR/lib
    export DLPGENERATOR_INCDIR=$DLPGENERATOR_BUILDDIR/include
    export LD_LIBRARY_PATH=$DLPGENERATOR_LIBDIR:$LD_LIBRARY_PATH
    export ROOT_INCLUDE_PATH=$DLPGENERATOR_INCDIR/DLPGenerator/ParticleBomb:$ROOT_INCLUDE_PATH
    export EDEPSIM_ROOT=/opt/edep-sim-install
    export PATH=$EDEPSIM_ROOT/bin:$DLPGENERATOR_BINDIR:$PATH
    export PYTHONPATH=/opt/JAXTPC:/opt/goop:$DLPGENERATOR_DIR/python:$PYTHONPATH

%files
    subgroups/lartpc/tests/ /opt/t1-lartpc-tests

%test
    set -e
    python3 -c "\
import ROOT, torch, jax; \
from tools.geometry import generate_detector; \
from tools.simulation import DetectorSimulator; \
import pimm_data, goop, dlp_generator; \
print('JAXTPC + pimm-data + goop + DLPGenerator + PyROOT import OK')"
    python3 /opt/t1-lartpc-tests/test_integration.py

    # Re-run each vendored package's own unit suite in-image. All three
    # self-skip GPU/asset-dependent cases. JAXTPC's tests resolve config
    # fixtures relative to cwd, hence the subshell `cd`.
    echo "== JAXTPC unit suite =="
    (cd /opt/JAXTPC && JAX_PLATFORM_NAME=cpu python3 -m pytest -q -p no:cacheprovider tests)
    echo "== pimm-data unit suite =="
    python3 -m pytest -q -p no:cacheprovider /opt/pimm-data/tests
    echo "== goop unit suite =="
    python3 -m pytest -q -p no:cacheprovider /opt/goop/tests

    echo "== DLPGenerator + edep-sim seam (bomb-macro -> H5DLP) =="
    bash /opt/t1-lartpc-tests/test_generator_edepsim.sh
