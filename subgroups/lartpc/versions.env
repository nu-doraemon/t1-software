# Pins for the LArTPC subgroup overlay.
# Bump these deliberately, not silently, on any nightly rebuild that
# discovers a new upstream commit -- see scripts/nightly-build.sh.
JAXTPC_COMMIT=806f9b3cced279314a3028b9bb4afba4104eca71
PIMM_DATA_COMMIT=168bf0205ba661952ce7e29b67fce76234df8a90
GOOP_COMMIT=cea65a18b25a21495d828b4c6ee80024538648c4

# Event generation (ROADMAP.md "Event generation" item) -- DLPGenerator's
# ParticleBomb is built first; edep-sim's own src/kinem/ParticleBombGenerator
# links against it directly (drinkingkazu/edep-sim is a fork of upstream
# edep-sim specifically adding that "/generator/kinematics/set bomb" seam),
# so DLPGENERATOR_COMMIT must be built (and DLPGENERATOR_INCDIR/LIBDIR
# exported) before EDEPSIM_COMMIT's cmake configure step runs.
DLPGENERATOR_COMMIT=cc0654a3e2dc07e9a83056cdf5afe749d9402d3a
EDEPSIM_COMMIT=b982cef9848da9376bb7f4573f321e9ac625a3a7
