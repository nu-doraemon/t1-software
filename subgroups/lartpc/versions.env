# Pins for the LArTPC subgroup overlay.
# Pins are bumped by hand. `scripts/build.sh --pin KEY=VALUE` overrides
# one for a single build without editing this file. Each <PKG>_REPO is
# the clone URL the Containerfile uses for that package.
# JAXTPC comes from drinkingkazu/JAXTPC (upstream 806f9b3 + the uint16
# group_sizes fix that pysupera's pixel reader requires); switch back to
# DeepLearnPhysics/JAXTPC by changing JAXTPC_REPO once that fix is merged upstream.
JAXTPC_REPO=https://github.com/drinkingkazu/JAXTPC.git
JAXTPC_COMMIT=e7b2615764a176d008829123fb27b47ebb7a55a0
PIMM_DATA_REPO=https://github.com/omaralterkait/pimm-data.git
PIMM_DATA_COMMIT=168bf0205ba661952ce7e29b67fce76234df8a90
GOOP_REPO=https://github.com/CIDeR-ML/goop.git
GOOP_COMMIT=e1a569eba44481cb2f6557ec9daad1ac4298683b

# goop's chroma sampler (ChromaTOFSampler, a hard import of `goop` since
# e1a569e). These are the commits goop's environment.yml and chroma-lar's
# pyproject.toml pin. All three install with --no-deps: chroma-lar pins
# torch==2.5.1 and TriChroma torch<2.6, which would replace the base
# image's Torch. TriChroma's kernels fail to compile under the Triton
# that the base Torch ships (3.7.1: MLIR TritonGPURemoveLayoutConversions
# error), so TRICHROMA_TRITON_VERSION overrides it with the Triton series
# TriChroma is validated on.
CHROMA_LAR_REPO=https://github.com/youngsm/chroma-lar.git
CHROMA_LAR_COMMIT=177b89d84cd07d440e2973386885206c5d8e714a
TRICHROMA_REPO=https://github.com/youngsm/trichroma.git
TRICHROMA_COMMIT=fcae69c31e92dc8422042e30a424955886812608
PHOTONLIB_REPO=https://github.com/CIDeR-ML/photonlib.git
PHOTONLIB_COMMIT=dd4da387bd8f0d952199c3be1b9413d582dfb76f
TRICHROMA_TRITON_VERSION=3.1.0

# Event generation (ROADMAP.md "Event generation" item) -- DLPGenerator's
# ParticleBomb is built first; edep-sim's own src/kinem/ParticleBombGenerator
# links against it directly (drinkingkazu/edep-sim is a fork of upstream
# edep-sim specifically adding that "/generator/kinematics/set bomb" seam),
# so DLPGENERATOR_COMMIT must be built (and DLPGENERATOR_INCDIR/LIBDIR
# exported) before EDEPSIM_COMMIT's cmake configure step runs.
DLPGENERATOR_REPO=https://github.com/DeepLearnPhysics/DLPGenerator.git
DLPGENERATOR_COMMIT=cc0654a3e2dc07e9a83056cdf5afe749d9402d3a
EDEPSIM_REPO=https://github.com/drinkingkazu/edep-sim.git
EDEPSIM_COMMIT=b982cef9848da9376bb7f4573f321e9ac625a3a7

# Label matching (pysupera) and the data-production controller (dprod,
# which drives edep-sim -> JAXTPC -> pysupera as one campaign).
PYSUPERA_REPO=https://github.com/drinkingkazu/pysupera.git
PYSUPERA_COMMIT=d2cef48e6b516e05f5007215ded209cdb288212f
DPROD_REPO=https://github.com/drinkingkazu/dprod.git
DPROD_COMMIT=f8c5be160026b444af66951904dd244b8f046621
