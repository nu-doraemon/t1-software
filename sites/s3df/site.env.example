# site.env for the S3DF nightly. Copy this file to <state>/site.env and
# set the two placeholders. nightly.py reads KEY=VALUE lines only: no
# shell expansion, and an empty value means the default.

# t1-software source. Anonymous HTTPS: no credentials on the cron node.
# Only pushed commits on this branch trigger a build.
T1_SOFTWARE_REPO=https://github.com/nu-doraemon/t1-software.git
# Branch whose HEAD the poll tracks.
T1_SOFTWARE_BRANCH=main
# CUDA variant passed to build.sh --variant.
VARIANT=cuda12
# Image store. Nightly images go to <IMAGES_DIR>/nightly/. Required.
IMAGES_DIR=/path/to/images
# Shared layer cache for build.sh --cache-dir. Empty: node-local cache only.
CACHE_DIR=
# build.sh --work-dir. Empty: build.sh's default ($LSCRATCH on S3DF). The
# scratch clone of t1-software also goes under this directory.
WORK_DIR=
# Successful nightlies whose image files are kept. Older ones lose their
# .oci.tar/.sif files; records, logs and manifests stay.
NIGHTLY_KEEP=7
# Cron interval in hours. The dashboard flags a poller older than twice this.
POLL_INTERVAL_HOURS=24
# Dashboard output. Empty: <state>/site.
DASHBOARD_DIR=
# Absolute path of uv for the Slurm job. Empty: the uv that runs nightly.py.
UV=
# Slurm account for the build job. Required.
SLURM_ACCOUNT=account:subaccount
# Partition and QoS. normal QoS: a preempted multi-hour build loses its work.
SLURM_PARTITION=ampere
SLURM_QOS=normal
# GPUs: the apptainer tests and the dprod pipeline test run on one GPU.
SLURM_GPUS=1
# CPUs: the generator and edep-sim steps compile with make -j$(nproc).
SLURM_CPUS=8
# Memory: JAXTPC's unit suite peaks near 11 GB inside the job's cgroup.
SLURM_MEM=32G
# Time limit. Set it to a measured nightly wall time plus 50 %.
SLURM_TIME=16:00:00
# Slurm commands. Override only for testing.
SBATCH=sbatch
SACCT=sacct
